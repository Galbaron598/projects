# ============================================
# MEDICAL SCHEDULING FRONTEND - ENV CONFIG
# ============================================

# ==========================================
# BACKEND SERVICES CONFIGURATION
# ==========================================

# Auth Service URL (Port 8000)
# Handles: OTP login, authentication, user profile
VITE_AUTH_SERVICE_URL=http://localhost:8000

# API Service URL (Port 8001)
# Handles: Appointments, doctors, medical fields, patients
VITE_API_SERVICE_URL=http://localhost:8001

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Application Name
VITE_APP_NAME=MediCare

# Application Version
VITE_APP_VERSION=1.0.0

# ==========================================
# DEPLOYMENT CONFIGURATION (Optional)
# ==========================================

# For production deployment, replace localhost with your domain:
# VITE_AUTH_SERVICE_URL=https://auth.yourdomain.com
# VITE_API_SERVICE_URL=https://api.yourdomain.com