# =============================================================================
# Medical Scheduling System - Environment Configuration
# =============================================================================
# 
# IMPORTANT: This file contains sensitive information!
# - DO NOT commit this file to Git (.gitignore should exclude it)
# - Create from .env.example and customize for your environment
# - Use strong, unique values for production
#
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
DB_HOST=localhost                    # Use 'postgres' for Docker, 'localhost' for local
DB_PORT=5432
DB_NAME=medical_scheduling
DB_USER=postgres
DB_PASSWORD=postgres

# Connection Pool Settings (for API Service)
DB_POOL_MIN_CONN=5                   # Minimum connections in pool
DB_POOL_MAX_CONN=20                  # Maximum connections allowed

# =============================================================================
# JWT & AUTHENTICATION
# =============================================================================

# JWT Secret Key (CRITICAL - Must be the same across all services!)
JWT_SECRET_KEY=dev-secret-key   
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440          # 24 hours (1440 minutes)

# OTP Configuration
OTP_LENGTH=6                         # 6-digit OTP code
OTP_EXPIRY_MINUTES=5                 # OTP valid for 5 minutes

# =============================================================================
# SERVICE URLS & PORTS
# =============================================================================

# Auth Service (Port 8000)
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8000
AUTH_SERVICE_URL=http://localhost:8000    # For local, use http://auth-service:8000 in Docker

# API Service (Port 8001)
API_SERVICE_HOST=0.0.0.0
API_SERVICE_PORT=8001
API_SERVICE_URL=http://localhost:8001

# Frontend (Port 3000)
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:8001

# CORS Settings
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================================
# ENVIRONMENT & DEBUGGING
# =============================================================================

# Environment Mode
ENVIRONMENT=development              # Options: development, staging, production
NODE_ENV=development                 # For frontend: development, production

# Debug Mode
DEBUG=True                           # Set to False in production
LOG_LEVEL=INFO                       # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# =============================================================================

# API Endpoints (for React frontend)
VITE_AUTH_SERVICE_URL=http://localhost:8000
VITE_API_SERVICE_URL=http://localhost:8001

# App Configuration
VITE_APP_NAME=Medical Scheduling System
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_MOCK_DATA=false          # Use mock data instead of real API
VITE_ENABLE_ANALYTICS=false          # Enable analytics tracking
VITE_ENABLE_DEBUG_TOOLS=true         # Show debug tools in UI

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================

# Email Service (if implementing email notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@medical-scheduling.com

# SMS Service (if implementing real SMS for OTP)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# File Storage (if implementing file uploads)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=medical-files

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60             # Max requests per minute per IP
RATE_LIMIT_ENABLED=true

# Session Settings
SESSION_TIMEOUT_MINUTES=30           # Inactive session timeout
MAX_LOGIN_ATTEMPTS=5                 # Max failed login attempts before lockout
LOCKOUT_DURATION_MINUTES=15          # How long account is locked after max attempts

# Password Policy (if implementing password auth in future)
# MIN_PASSWORD_LENGTH=8
# REQUIRE_UPPERCASE=true
# REQUIRE_LOWERCASE=true
# REQUIRE_NUMBERS=true
# REQUIRE_SPECIAL_CHARS=true

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry (Error Tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development

# Application Insights (Azure)
# APPINSIGHTS_INSTRUMENTATION_KEY=your-instrumentation-key

# Log Settings
LOG_FORMAT=json                      # Options: json, text
LOG_FILE_PATH=/var/log/medical-app.log
LOG_ROTATION_MAX_BYTES=10485760      # 10MB
LOG_ROTATION_BACKUP_COUNT=5

# =============================================================================
# DOCKER-SPECIFIC (when using Docker Compose)
# =============================================================================

# Service Names (Docker Compose uses these for inter-service communication)
POSTGRES_HOST=postgres               # Docker service name
AUTH_SERVICE_DOCKER_URL=http://auth-service:8000
API_SERVICE_DOCKER_URL=http://api-service:8001

# Volume Names
POSTGRES_VOLUME=medical-postgres-data

# =============================================================================
# PRODUCTION-SPECIFIC SETTINGS
# =============================================================================

# SSL/TLS (for production)
# ENABLE_HTTPS=true
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem

# Domain Configuration (for production)
# DOMAIN=medical-scheduling.com
# API_DOMAIN=api.medical-scheduling.com
# AUTH_DOMAIN=auth.medical-scheduling.com

# CDN (for production)
# CDN_URL=https://cdn.medical-scheduling.com

# =============================================================================
# TIMEZONE SETTINGS
# =============================================================================

# Default Timezone
DEFAULT_TIMEZONE=Asia/Jerusalem      # Default for Israel
TZ=Asia/Jerusalem                    # System timezone

# =============================================================================
# DEVELOPMENT-SPECIFIC
# =============================================================================

# Auto-reload (Development only)
AUTO_RELOAD=true
HOT_RELOAD=true

# Database Auto-create
AUTO_CREATE_TABLES=true              # Create tables on startup if missing
AUTO_SEED_DATA=false                 # Load seed data on startup

# Debug Tools
ENABLE_DEBUG_TOOLBAR=true
ENABLE_SQL_ECHO=false                # Log all SQL queries (verbose!)

# =============================================================================
# TESTING
# =============================================================================

# Test Database
TEST_DB_NAME=medical_scheduling_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=test_password

# =============================================================================
# NOTES
# =============================================================================
#
# Security Reminders:
# 1. Change all passwords and secrets before deploying
# 2. Never commit this file to version control
# 3. Use strong, random passwords (minimum 32 characters)
# 4. Rotate secrets regularly in production
# 5. Use a secrets manager (AWS Secrets Manager, Azure Key Vault) in production
#
# Generating Secure Secrets:
# - Random password: openssl rand -base64 32
# - Random JWT secret: openssl rand -base64 64
# - UUID: uuidgen (or python -c "import uuid; print(uuid.uuid4())")
#
# Environment-Specific Files:
# - Development: .env (this file)
# - Staging: .env.staging
# - Production: .env.production
# - Testing: .env.test
#
# Docker Usage:
# - When using docker-compose, these variables are automatically loaded
# - Services reference each other by service name (e.g., 'postgres', 'auth-service')
# - Change localhost to service names for internal communication
#
# =============================================================================
