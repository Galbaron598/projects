def productExceptSelf(nums):
    if nums is None:
        return "oh no!"
    
    if nums == []:
         return "oh no!"
     
    output = [1] * len(nums)
     
    prefix = 1
    for i in range(len(nums)):
        output[i] = prefix
        prefix *= nums[i]
        
    suffix = 1
    for i in range(len(nums) -1, -1,-1):
        output[i] *= suffix
        suffix *=  nums[i]
        
    return output

